{
  "name": "photography-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run images:manifest && npm run images:optimize && react-router build",
    "build:quick": "react-router build",
    "dev": "react-router dev",
    "start": "vite preview --outDir build/client",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "images:resize": "node ./scripts/resize-images.mjs",
    "images:manifest": "node ./scripts/generate-image-manifest.mjs",
    "images:optimize": "node ./scripts/generate-responsive-images.mjs"
  },
  "dependencies": {
    "@mantine/core": "^8.2.4",
    "@mantine/hooks": "^8.2.3",
    "@react-router/node": "^7.18.1",
    "@tabler/icons-react": "^3.34.1",
    "framer-motion": "^11.10.0",
    "isbot": "^5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-photo-album": "^3.1.0",
    "react-router": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@react-router/dev": "^7.18.1",
    "@types/node": "^20",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "exifr": "^7.1.3",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
